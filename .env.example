# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default, zero-config local dev):
DATABASE_URL=sqlite:///./pran_rfl.db
# Postgres (Docker / production) — uncomment and fill:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pran_rfl

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Options: "openrouter" (default) or "gemini"
AI_PROVIDER=openrouter

# ─── OpenRouter ──────────────────────────────────────────────────────────────
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-YOUR_OPENROUTER_KEY_HERE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.7-flash
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_REASONING_MAX_TOKENS=128

# ─── Google Gemini Direct (Alternative) ──────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_THINKING_BUDGET=128
GEMINI_THINKING_LEVEL=low
MAX_IMAGE_DIMENSION=1024

# ─── Token Pricing (USD per 1M tokens) ─────────────────────────────────────────
# OpenRouter listed rates for google/gemini-3.7-flash: $0.75/1M prompt, $3.75/1M completion
TOKEN_COST_INPUT_PER_MILLION=0.75
TOKEN_COST_OUTPUT_PER_MILLION=3.75

# ─── Local Image Storage ─────────────────────────────────────────────────────
# Images are stored on disk at ./media/uploads/ and served at /media/...
# Set this to the public base URL of the server so image_url is fully qualified.
STORAGE_BASE_URL=/

# ─── Upload Constraints ───────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (Next.js dev server, production domain, etc.)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
