# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default, zero-config local dev):
DATABASE_URL=sqlite:///./pran_rfl.db
# Postgres (Docker / production) — uncomment and fill:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pran_rfl

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Options: "openrouter" (default) or "gemini"
AI_PROVIDER=openrouter

# ─── OpenRouter ──────────────────────────────────────────────────────────────
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-YOUR_OPENROUTER_KEY_HERE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Best FMCG shelf recognition models:
# 1) google/gemini-2.5-flash-lite (Recommended: ~$0.10/$0.40 per 1M tokens - 85% cheaper)
# 2) google/gemini-2.0-flash-001  (Alternative: ~$0.10/$0.40 per 1M tokens)
# 3) google/gemini-3.7-flash      (Frontier: ~$0.75/$3.75 per 1M tokens)
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_REASONING_EFFORT=none
OPENROUTER_REASONING_MAX_TOKENS=0
OPENROUTER_MAX_TOKENS=450
OPENROUTER_TEMPERATURE=0.0
OPENROUTER_ENABLE_CACHE_HEADER=true

# ─── Google Gemini Direct (Alternative) ──────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_THINKING_BUDGET=0
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_OUTPUT_TOKENS=450
GEMINI_TEMPERATURE=0.0
GEMINI_MEDIA_RESOLUTION=medium

# ─── Vision Token & Image Optimization (Single-Tile Mode) ────────────────────
# 768px enforces a 1x1 tile grid (516 vision tokens instead of 1,290 tokens at 1024px).
# Reduces new image input tokens from ~1,410 down to ~600 tokens.
MAX_IMAGE_DIMENSION=768
IMAGE_QUALITY=82
ENABLE_IMAGE_CACHE=true
IMAGE_CACHE_TTL_HOURS=72

# ─── Token Pricing (USD per 1M tokens) ─────────────────────────────────────────
# Default rates for google/gemini-2.5-flash-lite ($0.10 input, $0.40 output)
# For Gemini 3.7 Flash: 0.75 / 3.75
TOKEN_COST_INPUT_PER_MILLION=0.10
TOKEN_COST_OUTPUT_PER_MILLION=0.40

# ─── Local Image Storage ─────────────────────────────────────────────────────
# Images are stored on disk at ./media/uploads/ and served at /media/...
# Set this to the public base URL of the server so image_url is fully qualified.
STORAGE_BASE_URL=/

# ─── Upload Constraints ───────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (Next.js dev server, production domain, etc.)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
