# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default, zero-config local dev):
DATABASE_URL=sqlite:///./pran_rfl.db
# Postgres (Docker / production) — uncomment and fill:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pran_rfl

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Options: "openrouter" (default) or "gemini"
AI_PROVIDER=openrouter

# ─── OpenRouter ──────────────────────────────────────────────────────────────
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-YOUR_OPENROUTER_KEY_HERE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Best FMCG shelf recognition models:
# 1) google/gemini-2.5-flash      (Recommended: ~$0.30/$2.50 per 1M tokens - 60% cheaper than 3.7 Flash, top accuracy)
# 2) google/gemini-2.5-flash-lite (Ultra-cheap: ~$0.10/$0.40 per 1M tokens)
# 3) google/gemini-3.7-flash      (Frontier: ~$0.75/$3.75 per 1M tokens)
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_REASONING_EFFORT=none
OPENROUTER_REASONING_MAX_TOKENS=0
OPENROUTER_MAX_TOKENS=600
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_FREQUENCY_PENALTY=0.2
OPENROUTER_ENABLE_CACHE_HEADER=true

# ─── Google Gemini Direct (Alternative) ──────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_THINKING_BUDGET=0
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_OUTPUT_TOKENS=1000
GEMINI_TEMPERATURE=0.0
GEMINI_MEDIA_RESOLUTION=medium

# ─── Vision Token & Image Optimization (Tile-Aligned Mode) ─────────────────────
# 1024px preserves label readability for small spice sachets while staying within 2 tiles (~774 tokens).
MAX_IMAGE_DIMENSION=896
IMAGE_QUALITY=82
ENABLE_IMAGE_CACHE=true
IMAGE_CACHE_TTL_HOURS=72

# ─── Token Pricing (USD per 1M tokens) ─────────────────────────────────────────
# Default rates for google/gemini-2.5-flash ($0.30 input, $2.50 output)
# For Gemini 2.5 Flash Lite: 0.10 / 0.40; For Gemini 3.7 Flash: 0.75 / 3.75
TOKEN_COST_INPUT_PER_MILLION=0.30
TOKEN_COST_OUTPUT_PER_MILLION=2.50

# ─── Local Image Storage ─────────────────────────────────────────────────────
# Images are stored on disk at ./media/uploads/ and served at /media/...
# Set this to the public base URL of the server so image_url is fully qualified.
STORAGE_BASE_URL=/

# ─── Upload Constraints ───────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (Next.js dev server, production domain, etc.)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
