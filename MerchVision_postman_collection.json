    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Ensure baseUrl has no trailing slash to prevent double-slashes in {{baseUrl}}/endpoint",
          "var b = pm.variables.get('baseUrl') || '';",
          "if (typeof b === 'string' && b.endsWith('/')) {",
          "    pm.variables.set('baseUrl', b.replace(/\\/+$/, ''));",
          "}"
        ]
      }
    }
  ],
