                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.upload_id) {",
                  "        pm.collectionVariables.set('upload_id', json.upload_id);",
                  "        console.log('Saved upload_id to collection variable:', json.upload_id);",
